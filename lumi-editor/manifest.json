{
  "manifest_version": 3,
  "name": "Lumi \u00b7 editor de planos",
  "version": "1.0.0",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://my.matterport.com/*",
    "https://app.companycam.com/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dilsar32-ops.github.io/amg-reportes/*"
      ],
      "js": [
        "bridge.js"
      ]
    }
  ]
}
